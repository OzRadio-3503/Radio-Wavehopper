<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- The logo fills the whole tile; its corners are rounded in code (RadioWidgetProvider). -->
    <ImageView
        android:id="@+id/w_logo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_launcher" />

    <ImageView
        android:id="@+id/w_play"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="center"
        android:contentDescription="Play or pause"
        android:src="@drawable/ic_tile_play" />
</FrameLayout>
