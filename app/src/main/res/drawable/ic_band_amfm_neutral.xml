<!-- AM/FM band toggle (Android Auto), neutral state - filter is off
     (All) or on DAB/Internet, so neither AM nor FM is lit. Two equal
     hollow (outline-only) blocks, matching the mono "tinted" icon
     convention every other custom button icon here uses - a filled,
     untinted icon risks being rejected/blanked by some car hosts. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="1.6"
          android:pathData="M2.8,9.8h8.4v5.4H2.8z" />
    <path android:fillColor="#00000000" android:strokeColor="#FF000000" android:strokeWidth="1.6"
          android:pathData="M12.8,9.8h8.4v5.4h-8.4z" />
</vector>
